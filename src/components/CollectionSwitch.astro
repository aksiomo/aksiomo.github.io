---
import { getCollections } from '../lib/common'

interface Props {
  current: string
}

const { current = '' } = Astro.props
const { lang } = Astro.params
const collections = await getCollections()

function label(name: string) {
  return name.charAt(0).toUpperCase() + name.slice(1)
}
---

<div class="relative" id="collection-switch-dropdown-keeper">
  <div class="px-4 py-2 cursor-pointer hover:bg-stone-200" id="collection-switch-dropdown-button">{current}</div>
  <div class="absolute h-max top-[-200%] left-0 bg-white shadow-lg w-max hidden" id="collection-switch-dropdown-body">
    <ul class="list-style-none flex flex-col">
      {collections.map((t) => (
        <li>
          <a href={`/${lang}/${t}`} class="block px-4 py-2 cursor-pointer hover:bg-stone-200 hover:text-stone-900">
            {label(t)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
const dropdownKeeper = document.getElementById('collection-switch-dropdown-keeper')
const dropdownButton = document.getElementById('collection-switch-dropdown-button')
const dropdownBody = document.getElementById('collection-switch-dropdown-body')

dropdownButton?.addEventListener('click', () => {
  dropdownBody?.classList.toggle('hidden')
})
dropdownButton?.addEventListener('mouseenter', () => {
  dropdownBody?.classList.remove('hidden')
})
dropdownKeeper?.addEventListener('mouseleave', () => {
  dropdownBody?.classList.add('hidden')
})
</script>
