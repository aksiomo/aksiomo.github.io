---
import { getCollection } from 'astro:content'

import titleLogo from '../assets/title.png'
import {
  personalLabel,
  personalLang,
  personalSubCollection,
} from '../lib/personal'

const pages = await getCollection('personal')
const { lang } = Astro.params
const langs = [...new Set(pages.map((page) => personalLang(page)))]
const subCollections = [
  ...new Set(
    pages
      .filter((page) => personalLang(page) === lang)
      .map((page) => personalSubCollection(page))
      .filter((name): name is string => Boolean(name)),
  ),
].sort()
const pathname = Astro.url.pathname
---

<header class="sticky top-0 z-20 border-b border-stone-200 bg-white/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-4">
    <a href={`/${lang}/personal`} class="shrink-0">
      <img src={titleLogo.src} alt="Aksiomo" class="h-11 w-auto" />
    </a>
    <div class="flex min-w-0 items-center gap-2">
      <div class="flex items-center gap-1 overflow-x-auto">
        {
          subCollections.map((name) => {
            const href = `/${lang}/personal/${name}`
            const active = pathname === href || pathname.startsWith(`${href}/`)
            return (
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'shrink-0 rounded-full px-3 py-1 text-sm capitalize transition-colors',
                  active
                    ? 'bg-stone-900 text-white'
                    : 'text-stone-600 hover:bg-stone-100 hover:text-stone-900',
                ]}
              >
                {personalLabel(name)}
              </a>
            )
          })
        }
      </div>
      <div class="relative shrink-0" data-lang-selector>
        <button
          type="button"
          class="cursor-pointer rounded-md border border-stone-200 px-2.5 py-1 text-sm uppercase tracking-wide text-stone-700 hover:bg-stone-50"
          data-lang-toggle
          aria-haspopup="listbox"
        >
          {lang}
        </button>
        <div
          class="absolute top-full right-0 z-30 mt-2 hidden min-w-28 overflow-hidden rounded-md border border-stone-200 bg-white py-1 shadow-lg"
          data-lang-menu
        >
          <ul>
            {
              langs.map((targetLang) => {
                const segments = Astro.url.pathname.split('/')
                segments[1] = targetLang
                const path = segments.join('/') || '/'
                const current = targetLang === lang
                return (
                  <li>
                    <a
                      href={path}
                      class:list={[
                        'block px-3 py-1.5 text-sm uppercase hover:bg-stone-100',
                        current && 'bg-stone-50 font-medium text-stone-900',
                      ]}
                    >
                      {targetLang}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll('[data-lang-selector]').forEach((root) => {
    const toggle = root.querySelector('[data-lang-toggle]')
    const menu = root.querySelector('[data-lang-menu]')
    toggle?.addEventListener('click', (event) => {
      event.stopPropagation()
      menu?.classList.toggle('hidden')
    })
    document.addEventListener('click', () => {
      menu?.classList.add('hidden')
    })
  })
</script>
