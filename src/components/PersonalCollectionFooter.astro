---
const year = new Date().getFullYear()
const { lang } = Astro.params
---

<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-4 py-6 text-sm text-stone-500">
    <p>© {year} Aksiomo Luna</p>
    <a href={`/${lang}/personal`} class="hover:text-stone-900">Personal</a>
  </div>
</footer>
